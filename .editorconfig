root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt, kernel style, and make all want tabs.
[{*.go,*.c,*.h,Makefile}]
indent_style = tab
indent_size = 8

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
